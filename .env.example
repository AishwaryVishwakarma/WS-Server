PORT=8000
SESSION_SECRET=dev-session-secret-change-me
SALT_ROUNDS=10

# Bearer token a Prometheus scraper must send to read GET /metrics. Optional
# locally (the endpoint stays closed without it); REQUIRED in production.
METRICS_TOKEN=dev-metrics-token-change-me

# Google OAuth client id for "Sign in with Google" (Google Cloud Console →
# Credentials → OAuth client → Web). Optional — unset disables the feature
# (POST /auth/google returns 503 and the web button hides). Set the SAME value
# as the web's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Defaults match the dockerized dev infrastructure (npm run dev:infra:up).
# For a natively installed Postgres/Redis, change these accordingly
# (e.g. DB_PORT=5432, REDIS_URL=redis://localhost:6379).
REDIS_URL=redis://localhost:6380
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=dev
DB_PORT=3310
DB_NAME=ws_dev

# Postgres pool size (pg Pool's max). Optional — defaults to 10. Watch
# ws_db_pool_connections{state="free"} in /metrics before raising this: a
# free count sitting near zero under load is the signal, not a guess.
DB_POOL_SIZE=
# Logs PostgreSQL queries exceeding this duration through TypeORM's logger.
DB_SLOW_QUERY_MS=500

# Where a password-reset email's link points. Optional — defaults to
# http://localhost:3000 (the web dev server) when unset.
# Production: https://whisperingshadows.net
FRONTEND_URL=http://localhost:3000

# Public origin of this API, used for one-click email unsubscribe links.
# Railway can infer it from RAILWAY_PUBLIC_DOMAIN when this is unset.
BACKEND_URL=http://localhost:8000

# Appwrite Storage (server-only). The API key must never be exposed to WS-Web.
# Bucket: max 5 MB; jpg/jpeg/png/webp; compression none; public read.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_IMAGE_BUCKET_ID=
# Admin storage dashboard budget (2 GiB). Appwrite bucket maximumFileSize is a
# per-file limit, not the account's total storage quota.
APPWRITE_IMAGE_CAPACITY_BYTES=2147483648
# Required logical partition when environments share the free-plan bucket.
APPWRITE_IMAGE_NAMESPACE=development
# Fail closed: the admin can inspect usage, but cannot purge unless enabled.
IMAGE_PURGE_ENABLED=false

# Resend's HTTPS API for outgoing email (password-reset links and
# registration OTP codes) — https://resend.com/api-keys. Both optional —
# unset RESEND_API_KEY disables real delivery: MailService logs the message
# instead, so both flows are still fully exercisable locally (grab the
# link/code from the server console) without a real API key. Sent over
# HTTPS rather than SMTP since several PaaS hosts (Railway included) silently
# drop outbound SMTP connections.
RESEND_API_KEY=
# Signing secret from the Resend webhook details page. Subscribe the endpoint
# /webhooks/resend to bounced, complained, and suppressed email events.
RESEND_WEBHOOK_SECRET=
MAIL_FROM=no-reply@whisperingshadows.net

# Approximate session locations. Download GeoLite2 City locally and point to
# its MMDB file. Production Docker downloads it at startup when both MaxMind
# credentials are set; obtain them from a free MaxMind GeoLite account.
GEOIP_DATABASE_PATH=
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
