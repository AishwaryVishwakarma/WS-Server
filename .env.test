# Integration test environment — matches docker-compose.test.yml.
# Contains only throwaway container credentials; safe to commit.
PORT=8001
SESSION_SECRET=test-session-secret
METRICS_TOKEN=test-metrics-token
REDIS_URL=redis://localhost:6381
SALT_ROUNDS=4
# Rate limiting off by default here — integration flows fire far more requests
# than any tier allows. The rate-limit suite overrides this before booting.
THROTTLE_DISABLED=true
DB_HOST=localhost
DB_PORT=3311
DB_USERNAME=root
DB_PASSWORD=test
DB_NAME=ws_test
# Dummy values so the integration app can boot with billing "configured" —
# LemonSqueezyService itself is stubbed in tests that would otherwise hit the
# real API, but the webhook signature tests need a real secret to sign
# fixtures against, and the config validator requires the group all-or-nothing.
LEMONSQUEEZY_API_KEY=test-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=1
LEMONSQUEEZY_PATRON_VARIANT_ID=1
LEMONSQUEEZY_WEBHOOK_SECRET=test-lemonsqueezy-webhook-secret
